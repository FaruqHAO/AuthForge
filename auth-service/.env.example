# =============================================================================
# Auth Service - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME="Auth Service"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true

# Secret key for application-level signing (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://auth_user:auth_password@localhost:5432/auth_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Secret key for signing JWTs (min 32 chars, different from SECRET_KEY)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-another-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email (SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@auth-service.local
SMTP_USE_TLS=true

# --- Rate Limiting ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour
RATE_LIMIT_PASSWORD_RESET=3/hour

# --- Cookie Authentication ---
# Set to true for browser-based apps (Angular) that use cookie auth
COOKIE_ENABLED=false
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# --- Admin Bootstrap ---
# Initial admin password (only used by seed script, never hardcoded)
ADMIN_PASSWORD=change-me-admin-password
ADMIN_EMAIL=admin@example.com
